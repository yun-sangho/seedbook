{
  "name": "@seedbook/web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/worktree.mjs env web 'next dev --port $API_PORT'",
    "build": "node scripts/copy-app.mjs && next build && serwist build",
    "start": "next start",
    "check-types": "next typegen && tsc --noEmit",
    "format": "biome check --write --linter-enabled=false",
    "format:check": "biome check --linter-enabled=false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node ../../scripts/worktree.mjs env test-db 'vitest run --config vitest.db.config.ts'",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@karrotmarket/react-monochrome-icon": "^1.35.0",
    "@seed-design/css": "^3.3.0",
    "@seed-design/react": "^3.3.0",
    "@seed-design/tailwind4-theme": "^3.1.0",
    "@seedbook/database": "workspace:*",
    "@seedbook/domain": "workspace:*",
    "@seedbook/mobile": "workspace:*",
    "@serwist/next": "9.5.13",
    "better-auth": "^1.7.23",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "jose": "6.2.17",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@serwist/cli": "9.5.13",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "serwist": "9.5.13",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
