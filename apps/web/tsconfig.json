{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@web/*": ["./*"],
      "@mobile/*": ["../mobile/src/*"],
      "@seedbook/database": ["../../packages/database/src"],
      "@seedbook/database/*": ["../../packages/database/src/*"],
      "@seedbook/domain": ["../../packages/domain/src"],
      "@seedbook/domain/*": ["../../packages/domain/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../mobile/src/**/*.d.ts",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
