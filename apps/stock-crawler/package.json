{
  "name": "@seedbook/stock-crawler",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "crawl:stocks": "tsx src/jobs/sync-stock-list.ts",
    "crawl:prices": "tsx src/jobs/sync-stock-prices.ts",
    "crawl:all": "tsx src/jobs/run-all.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@seedbook/database": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "node-cron": "^3.0.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
