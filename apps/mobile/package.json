{
  "name": "@seedbook/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/worktree.mjs env mobile 'vite'",
    "build": "vite build",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "format": "biome check --write --linter-enabled=false",
    "format:check": "biome check --linter-enabled=false",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:www": "node scripts/build-www.mjs",
    "sync": "pnpm build:www && cap sync",
    "sync:ios": "pnpm build:www && cap sync ios",
    "sync:android": "pnpm build:www && cap sync android",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capgo/capacitor-native-biometric": "8.9.1",
    "@karrotmarket/react-monochrome-icon": "^1.35.0",
    "@seed-design/css": "^3.3.0",
    "@seed-design/react": "^3.3.0",
    "@seed-design/stackflow": "^2.1.1",
    "@seed-design/tailwind4-theme": "^3.1.0",
    "@seedbook/domain": "workspace:*",
    "@seedbook/native-plugins": "workspace:*",
    "@stackflow/config": "^2.0.0",
    "@stackflow/core": "^3.1.0",
    "@stackflow/plugin-history-sync": "^2.1.0",
    "@stackflow/plugin-renderer-basic": "^1.1.16",
    "@stackflow/react": "^2.1.4",
    "better-auth": "^1.7.23",
    "clsx": "^2.1.1",
    "history": "5.3.0",
    "lucide-react": "^1.72.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "1.16.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
