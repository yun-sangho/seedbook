generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "seedbook"]
}

// 주식 종목 마스터.
// 복합 PK (market, ticker) 로 시장 간 동일 티커 충돌 방지 —
// 추후 NASDAQ/NYSE 등 해외 시장 추가 시 스키마 변경이 필요 없도록 설계.
model Stock {
  market    String // KOSPI | KOSDAQ | KONEX | 향후 NASDAQ | NYSE 등
  ticker    String // KR: 6자리 숫자 (예: "005930") | US: 알파벳 심볼 (예: "AAPL")
  name      String // 종목명
  currency  String       @default("KRW") // KRW | USD
  sector    String? // 업종
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  prices    StockPrice[]

  @@id([market, ticker])
  @@index([market])
  @@index([isActive])
  @@index([name])
  @@schema("public")
}

model StockPrice {
  id          Int      @id @default(autoincrement())
  stockMarket String
  stockTicker String
  // 거래일 (trading day) 을 canonical instant 로 저장. 값은 항상 해당 거래일의
  // KST 자정 (00:00 Asia/Seoul, = 전날 15:00 UTC) — 크롤러는 `kstMidnight()`
  // 헬퍼로 계산해서 넣는다. 표시/쿼리 시 KST 기준으로 변환한다.
  // 타입은 `timestamptz` — Postgres 가 UTC 로 저장하고 클라이언트 tz 로 읽어준다.
  date        DateTime @db.Timestamptz(3)
  open        BigInt // 시가 (원)
  high        BigInt // 고가
  low         BigInt // 저가
  close       BigInt // 종가
  volume      BigInt // 거래량
  marketCap   BigInt? // 시가총액
  change      BigInt? // 전일대비
  stock       Stock    @relation(fields: [stockMarket, stockTicker], references: [market, ticker])

  @@unique([stockMarket, stockTicker, date])
  @@index([date])
  @@index([stockMarket, stockTicker])
  @@schema("public")
}

// --- Better Auth (Kakao login) ---
// 이 네 테이블은 Better Auth prismaAdapter 가 관리한다.
// seedbook 스키마 아래에 위치시켜 stock 관련 public 테이블과 네임스페이스를 분리한다.

model User {
  id            String      @id
  name          String
  email         String      @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  userStores    UserStore[]

  @@map("user")
  @@schema("seedbook")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
  @@schema("seedbook")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
  @@schema("seedbook")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
  @@schema("seedbook")
}

// --- Cloud-synced per-user Zustand store blobs ---
// Each row is the full `{ state, version }` envelope that Zustand's
// `persist` middleware serializes for one store. We store it as a single
// `Json` column and never introspect its shape — store-specific migrations
// continue to run client-side via `persist`'s `migrate` callback.
//
// `(userId, key)` is the composite PK: one row per user per store key.
model UserStore {
  userId    String
  key       String // e.g. "investment-storage", "savings-storage"
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([userId])
  @@map("user_store")
  @@schema("seedbook")
}
