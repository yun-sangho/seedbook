generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "seedbook"]
}

// 주식 종목 마스터.
// 복합 PK (market, ticker) 로 시장 간 동일 티커 충돌 방지 —
// 추후 NASDAQ/NYSE 등 해외 시장 추가 시 스키마 변경이 필요 없도록 설계.
model Stock {
  market    String // KOSPI | KOSDAQ | KONEX | 향후 NASDAQ | NYSE 등
  ticker    String // KR: 6자리 숫자 (예: "005930") | US: 알파벳 심볼 (예: "AAPL")
  name      String // 종목명
  currency  String       @default("KRW") // KRW | USD
  sector    String? // 업종
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  prices    StockPrice[]

  @@id([market, ticker])
  @@index([market])
  @@index([isActive])
  @@index([name])
  @@schema("public")
}

model StockPrice {
  id          Int      @id @default(autoincrement())
  stockMarket String
  stockTicker String
  // 거래일 (trading day) 을 canonical instant 로 저장. 값은 항상 해당 거래일의
  // KST 자정 (00:00 Asia/Seoul, = 전날 15:00 UTC) — 크롤러는 `kstMidnight()`
  // 헬퍼로 계산해서 넣는다. 표시/쿼리 시 KST 기준으로 변환한다.
  // 타입은 `timestamptz` — Postgres 가 UTC 로 저장하고 클라이언트 tz 로 읽어준다.
  date        DateTime @db.Timestamptz(3)
  open        BigInt // 시가 (원)
  high        BigInt // 고가
  low         BigInt // 저가
  close       BigInt // 종가
  volume      BigInt // 거래량
  marketCap   BigInt? // 시가총액
  change      BigInt? // 전일대비
  stock       Stock    @relation(fields: [stockMarket, stockTicker], references: [market, ticker])

  @@unique([stockMarket, stockTicker, date])
  @@index([date])
  @@index([stockMarket, stockTicker])
  @@schema("public")
}

// --- Better Auth (Kakao login) ---
// 이 네 테이블은 Better Auth prismaAdapter 가 관리한다.
// seedbook 스키마 아래에 위치시켜 stock 관련 public 테이블과 네임스페이스를 분리한다.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  // 자산 데이터 (정규화된 도메인 테이블들)
  investmentAccounts  InvestmentAccount[]
  savingsAccounts     SavingsAccount[]
  debts               Debt[]
  realAssets          RealAsset[]
  assetPlans          AssetPlan[]
  assetProgressPoints AssetProgressPoint[]
  portfolios          Portfolio[]

  // 유저 설정 / UI 선호도 (데이터와 별도 분리)
  preference UserPreference?
  listOrders UserListOrder[]

  // 데이터 공유
  sharesOwned    DataShare[]           @relation("SharesOwned")
  sharesReceived DataShareAcceptance[] @relation("SharesReceived")

  @@map("user")
  @@schema("seedbook")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
  @@schema("seedbook")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
  @@schema("seedbook")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
  @@schema("seedbook")
}

// ============================================================================
// 자산 데이터 (seedbook 스키마)
// ============================================================================
//
// 설계 원칙:
//   1. 모든 금액은 BigInt (원 단위). JSON 경계에서 Number 로 캐스팅 — 현실적인
//      자산 규모는 JS Number.MAX_SAFE_INTEGER 에 한참 못 미침.
//   2. id 는 클라이언트가 `crypto.randomUUID()` 로 생성해 보낸다. 서버는
//      받은 그대로 저장만 함. Postgres 는 `@db.Uuid` (16 bytes native binary)
//      로 저장해 TEXT (36 bytes) 대비 2.5 배 공간을 절약한다.
//   3. 표시 순서 / 계정 정렬옵션 같은 UI 선호도는 데이터 테이블에 섞지 않고
//      `UserPreference`, `UserListOrder` 로 분리한다.
//   4. 스냅샷 날짜는 `@db.Date` (시간대 없음) — 하루 1 포인트.
// ============================================================================

// ─── Investments ───────────────────────────────────────────────────────────

model InvestmentAccount {
  id                String   @id @db.Uuid // 클라이언트가 생성한 UUID (16 bytes native)
  userId            String
  accountName       String
  accountType       String
  currency          String
  initialInvestment BigInt // 현재 투자 원금 (원)
  currentValue      BigInt // 현재 평가 금액 (원)
  note              String   @default("")
  color             String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  records   InvestmentRecord[]
  holdings  StockHolding[]
  cashItems CashItem[]

  @@index([userId])
  @@map("investment_account")
  @@schema("seedbook")
}

model InvestmentRecord {
  accountId         String   @db.Uuid
  date              DateTime @db.Date // 같은 계좌는 하루 1건만 존재
  initialInvestment BigInt
  currentValue      BigInt

  account InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, date])
  @@index([accountId, date])
  @@map("investment_record")
  @@schema("seedbook")
}

model StockHolding {
  id        String @id @db.Uuid // 클라이언트가 생성한 UUID (16 bytes native)
  accountId String @db.Uuid
  // Stock 마스터에서 복제된 정보. FK 를 걸지 않는 이유: 사용자가 직접 편집할 수
  // 있고, 마스터에 없는 종목 (해외 소형주 등) 도 수동 입력 가능해야 함.
  market   String
  ticker   String
  name     String
  currency String
  quantity Float // 분수 수량 지원 (예: 0.5 주)
  memo     String @default("")

  account InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("stock_holding")
  @@schema("seedbook")
}

model CashItem {
  id        String @id @db.Uuid // 클라이언트가 생성한 UUID (16 bytes native)
  accountId String @db.Uuid
  label     String // "예수금", "CMA" 등 사용자 편집 가능
  amount    BigInt

  account InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("cash_item")
  @@schema("seedbook")
}

// ─── Savings ───────────────────────────────────────────────────────────────

model SavingsAccount {
  id           String   @id @db.Uuid // 클라이언트가 생성한 UUID (16 bytes native)
  userId       String
  accountName  String
  accountType  String
  currency     String
  balance      BigInt
  interestRate Float?
  note         String   @default("")
  color        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  records SavingsRecord[]

  @@index([userId])
  @@map("savings_account")
  @@schema("seedbook")
}

model SavingsRecord {
  accountId String   @db.Uuid
  date      DateTime @db.Date
  balance   BigInt

  account SavingsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, date])
  @@index([accountId, date])
  @@map("savings_record")
  @@schema("seedbook")
}

// ─── Debts ─────────────────────────────────────────────────────────────────

model Debt {
  id             String    @id @db.Uuid // 클라이언트가 생성한 UUID (16 bytes native)
  userId         String
  loanName       String
  loanType       String
  lender         String
  amount         BigInt
  interestRate   Float
  maturityDate   DateTime? @db.Date
  monthlyPayment BigInt
  note           String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("debt")
  @@schema("seedbook")
}

// ─── Real Assets ───────────────────────────────────────────────────────────

model RealAsset {
  id            String    @id @db.Uuid // 클라이언트가 생성한 UUID (16 bytes native)
  userId        String
  assetName     String
  assetType     String
  currentValue  BigInt
  purchaseValue BigInt
  purchaseDate  DateTime? @db.Date
  note          String    @default("")
  color         String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("real_asset")
  @@schema("seedbook")
}

// ─── Asset Plans ───────────────────────────────────────────────────────────

model AssetPlan {
  id                       String   @id @db.Uuid // 클라이언트가 생성한 UUID (16 bytes native)
  userId                   String
  planName                 String
  planPeriod               Int // 년
  totalMonthlyContribution BigInt
  averageTargetReturn      Float
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountItems AssetPlanAccountItem[]

  @@index([userId])
  @@map("asset_plan")
  @@schema("seedbook")
}

// 한 plan 이 여러 계좌(투자/저축) 에 대한 계획 항목을 갖는다.
// `accountKind` 는 discriminator — FK 제약은 걸지 않음 (polymorphic 참조).
// 앱 레벨에서 investment/savings 계좌가 존재하는지 검증.
model AssetPlanAccountItem {
  planId                String   @db.Uuid
  accountId             String   @db.Uuid
  accountKind           String // "investment" | "savings"
  contributionAmount    BigInt
  contributionFrequency String // "월" | "분기" | "반기" | "년"
  targetAnnualReturn    Float

  plan AssetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, accountId])
  @@index([planId])
  @@map("asset_plan_account_item")
  @@schema("seedbook")
}

// ─── Portfolios ────────────────────────────────────────────────────────────

// 한국 주식 모델 포트폴리오. 한 유저가 여러 개를 만들어 비교 가능 (안정형 / 공격형 등).
// 비중(targetPercent) 합계는 앱 레벨에서 100% 이하로 검증한다 — 미배정분은 "현금" 으로 해석.
model Portfolio {
  id          String   @id @db.Uuid // 클라이언트가 생성한 UUID (16 bytes native)
  userId      String
  name        String
  description String   @default("")
  color       String
  note        String   @default("")
  // 포트폴리오가 적용되는 InvestmentAccount.id 목록 (polymorphic 참조, FK 없음).
  // 빈 배열 = 연결 없음, 즉 "모든 투자 계좌 합산" 을 의미.
  accountIds  String[] @default([]) @db.Uuid
  // 이격률 경고 임계값 (%). |gapPercent| 가 이 값을 넘으면 UI 에서 경고 배지 노출.
  driftThresholdPercent Float @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations PortfolioAllocation[]

  @@index([userId])
  @@map("portfolio")
  @@schema("seedbook")
}

model PortfolioAllocation {
  id            String @id @db.Uuid // 클라이언트가 생성한 UUID (16 bytes native)
  portfolioId   String @db.Uuid
  // Stock 마스터에서 복제된 정보. FK 를 걸지 않는 이유: 사용자가 마스터에 없는
  // 종목도 직접 추가할 수 있어야 하고, 마스터 갱신/삭제로 인한 영향 최소화.
  market        String
  ticker        String
  name          String
  currency      String
  targetPercent Float // 0~100, 소수 허용 (예: 12.5)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("portfolio_allocation")
  @@schema("seedbook")
}

// ─── Progress ──────────────────────────────────────────────────────────────

model AssetProgressPoint {
  userId      String
  date        DateTime @db.Date
  totalAssets BigInt
  netAssets   BigInt
  investments BigInt
  savings     BigInt
  realAssets  BigInt
  loans       BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@index([userId, date])
  @@map("asset_progress_point")
  @@schema("seedbook")
}

// ============================================================================
// 유저 설정 / UI 선호도 (데이터와 분리)
// ============================================================================
//
// 원칙: "자산 데이터" 테이블 (account, debt, ...) 에는 순수 데이터 필드만 둔다.
// 화면 표시 순서, 정렬 옵션, 기타 설정은 모두 여기서 관리 — 추후 디바이스별
// 로컬 설정과 서버 설정을 나눌 때도 이 쪽만 확장하면 된다.
// ============================================================================

// 1 유저 1 행. 단일 값 UI 설정들의 보금자리.
model UserPreference {
  userId             String @id
  holdingsSortOption String @default("default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preference")
  @@schema("seedbook")
}

// 유저가 지정한 리스트 정렬 순서. domain 별로 1 행. `order` 는 해당 리스트의
// entity id 를 순서대로 담은 `text[]`. 리스트에 없는 id (신규 추가) 는 끝에
// 붙여서 렌더.
//
// domain 예시: "investment-accounts" | "savings-accounts" | "real-assets" |
// "debts" | "asset-plans"
model UserListOrder {
  userId String
  domain String
  order  String[] // Postgres text[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, domain])
  @@index([userId])
  @@map("user_list_order")
  @@schema("seedbook")
}

// ============================================================================
// 데이터 공유 (Data Sharing)
// ============================================================================
//
// 소유자가 공유 코드를 발급하고, 수신자가 코드를 입력해 수락하면 소유자의
// 전체 자산 데이터를 읽기 전용으로 열람할 수 있다. 클라우드 모드 사용자만
// 이용 가능 (데이터가 DB 에 있어야 공유할 수 있음).
//
//   - DataShare: 소유자가 만든 공유 "초대". 코드와 라벨을 갖는다.
//   - DataShareAcceptance: 수신자가 코드를 수락한 결과. (share, recipient) 쌍이
//     유일하다. 소유자가 acceptance 를 삭제하면 해당 수신자의 접근만 차단.
//     share 전체를 삭제하면 모든 수락자의 접근이 차단된다 (cascade).
// ============================================================================

model DataShare {
  id          String    @id @default(uuid()) @db.Uuid
  ownerUserId String
  code        String    @unique
  label       String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  owner       User                  @relation("SharesOwned", fields: [ownerUserId], references: [id], onDelete: Cascade)
  acceptances DataShareAcceptance[]

  @@index([ownerUserId])
  @@map("data_share")
  @@schema("seedbook")
}

model DataShareAcceptance {
  id              String   @id @default(uuid()) @db.Uuid
  shareId         String   @db.Uuid
  recipientUserId String
  acceptedAt      DateTime @default(now())

  share     DataShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  recipient User      @relation("SharesReceived", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([shareId, recipientUserId])
  @@index([recipientUserId])
  @@map("data_share_acceptance")
  @@schema("seedbook")
}
