{
  "name": "@seedbook/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:capture": "tsx scripts/capture-seed.ts",
    "db:seed:reset": "tsx scripts/reset-dev-user.ts",
    "db:backfill:account-portfolio": "tsx scripts/backfill-account-portfolio-links.ts",
    "etl:etf:prices": "tsx ./scripts/fetch-etf-prices.ts",
    "etl:etf:holdings": "tsx ./scripts/fetch-etf-holdings.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
