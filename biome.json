{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/seed-data",
      "!packages/database/migrations",
      "!**/.claude",
      "!apps/web/public"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ["react", "react/**"],
              ["next", "next/**"],
              [":NODE:", ":PACKAGE:"],
              ":ALIAS:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "next": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/{app,components,features,hooks,lib,types,utils}/**",
        "!apps/web/app/api/**",
        "!apps/web/app/(site)/**",
        "!apps/web/app/layout.tsx",
        "!apps/web/app/manifest.ts",
        "!apps/web/app/sw.ts",
        "!apps/web/lib/auth.ts",
        "!apps/web/lib/auth-server.ts",
        "!apps/web/lib/auth-privacy.ts",
        "!apps/web/lib/apple-auth.ts",
        "!apps/web/lib/stock-quotes/**",
        "!apps/web/lib/native/device-db/testing/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@seedbook/database",
                      "@seedbook/database/**",
                      "@web/server/**",
                      "@web/app/api/**",
                      "node:*"
                    ],
                    "message": "클라이언트 코드(앱 번들)는 서버·DB·node 모듈을 import 하지 않는다. 서버와 같이 쓰는 순수 로직은 @seedbook/domain 에 둔다 (lib/client-imports-guard.test.ts)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
