# 이 모노레포는 단일 `.env.local` 을 repo 루트에 두고 사용한다.
# 각 서브 프로젝트(apps/web, packages/database …) 는 심링크로 이 파일을 공유한다:
#   apps/web/.env.local          -> ../../.env.local
#   packages/database/.env.local -> ../../.env.local
# 초기 설정:
#   cp .env.example .env.local
#   ln -sf ../../.env.local apps/web/.env.local
#   ln -sf ../../.env.local packages/database/.env.local

# PostgreSQL
POSTGRES_USER=seedbook
POSTGRES_PASSWORD=seedbook
POSTGRES_DB=seedbook
POSTGRES_PORT=5432

# Database URL (for local dev without Docker)
DATABASE_URL=postgresql://seedbook:seedbook@localhost:5432/seedbook

# Cron schedules (KST, weekdays only)
# CRON_MORNING=0 6 * * 1-5
# CRON_AFTERNOON=30 16 * * 1-5

# Better Auth — Kakao OAuth
# Kakao Dev Console: https://developers.kakao.com/
#   1. 내 애플리케이션 > 앱 설정 > 앱 키 > REST API 키        -> KAKAO_CLIENT_ID
#   2. 제품 설정 > 카카오 로그인 > 활성화 ON
#   3. 제품 설정 > 카카오 로그인 > Redirect URI 등록:
#        http://localhost:3001/api/auth/callback/kakao  (dev)
#   4. 제품 설정 > 보안 > Client Secret 코드 생성 + 활성화   -> KAKAO_CLIENT_SECRET
#   5. 제품 설정 > 카카오 로그인 > 동의항목: 닉네임(필수), 프로필 사진(선택)
# BETTER_AUTH_SECRET 은 `openssl rand -base64 32` 로 생성
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
